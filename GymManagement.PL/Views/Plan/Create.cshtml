@model GymManagement.BLL.Features.Plans.Commands.AddPlan.AddPlanCommand

@{
    ViewData["Title"] = "Create Plan";
}

<style>
    .create-page {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .page-header {
        margin-bottom: 28px;
    }

    .page-header h1 {
        font-size: 32px;
        font-weight: 700;
        margin: 0 0 8px;
        color: #1f2937;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
        font-size: 15px;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
        overflow: hidden;
    }

    .form-card-header {
        padding: 24px 30px;
        border-bottom: 1px solid #e5e7eb;
        background: #fafafa;
    }

    .form-card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: #111827;
    }

    .form-card-header p {
        margin: 6px 0 0;
        font-size: 14px;
        color: #6b7280;
    }

    .form-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 24px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #374151;
    }

    .form-control {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        font-size: 15px;
        color: #111827;
        background: #fff;
        outline: none;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .form-control:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }

    textarea.form-control {
        min-height: 130px;
        resize: vertical;
    }

    .field-validation-error {
        display: block;
        margin-top: 6px;
        color: #dc2626;
        font-size: 13px;
    }

    .validation-summary-errors {
        margin-bottom: 24px;
        padding: 14px 16px;
        border-radius: 9px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        font-size: 14px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        padding-top: 24px;
        margin-top: 10px;
        border-top: 1px solid #e5e7eb;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 20px;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
        border: none;
    }

    .btn-cancel {
        background: #f3f4f6;
        color: #374151;
    }

    .btn-cancel:hover {
        background: #e5e7eb;
    }

    .btn-primary {
        background: #4f46e5;
        color: white;
    }

    .btn-primary:hover {
        background: #4338ca;
        transform: translateY(-1px);
        box-shadow: 0 5px 15px rgba(79, 70, 229, 0.25);
    }

    .required {
        color: #dc2626;
        margin-left: 3px;
    }

    .input-hint {
        margin-top: 6px;
        font-size: 12px;
        color: #9ca3af;
    }

    @@media (max-width: 700px) {
        .create-page {
            margin: 20px auto;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-body {
            padding: 20px;
        }

        .form-card-header {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn {
            width: 100%;
        }
    }
</style>


<div class="create-page">

    <!-- Page Header -->
    <div class="page-header">
        <h1>Create Plan</h1>
        <p>Add a new membership plan to your gym.</p>
    </div>


    <!-- Form Card -->
    <div class="form-card">

        <div class="form-card-header">
            <h2>Plan Information</h2>
            <p>Enter the details of the new membership plan.</p>
        </div>


        <form asp-controller="Plan"
              asp-action="Create"
              method="post">

            <div class="form-body">

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"></div>


                <!-- Name -->
                <div class="form-group">

                    <label asp-for="Name" class="form-label">
                        Plan Name
                        <span class="required">*</span>
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="e.g. Premium Monthly Plan"
                           autocomplete="off" />

                    <span asp-validation-for="Name"></span>

                </div>


                <!-- Description -->
                <div class="form-group">

                    <label asp-for="Description" class="form-label">
                        Description
                        <span class="required">*</span>
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              placeholder="Describe what this membership plan includes..."></textarea>

                    <span asp-validation-for="Description"></span>

                    <div class="input-hint">
                        Enter between 10 and 500 characters.
                    </div>

                </div>


                <!-- Duration + Price -->
                <div class="form-row">

                    <!-- Duration -->
                    <div class="form-group">

                        <label asp-for="DurationDays" class="form-label">
                            Duration
                            <span class="required">*</span>
                        </label>

                        <input asp-for="DurationDays"
                               class="form-control"
                               type="number"
                               min="1"
                               placeholder="30" />

                        <span asp-validation-for="DurationDays"></span>

                        <div class="input-hint">
                            Duration in days.
                        </div>

                    </div>


                    <!-- Price -->
                    <div class="form-group">

                        <label asp-for="Price" class="form-label">
                            Price
                            <span class="required">*</span>
                        </label>

                        <input asp-for="Price"
                               class="form-control"
                               type="number"
                               min="0.01"
                               step="0.01"
                               placeholder="500.00" />

                        <span asp-validation-for="Price"></span>

                        <div class="input-hint">
                            Enter the plan price.
                        </div>

                    </div>

                </div>


                <!-- Actions -->
                <div class="form-actions">

                    <a asp-controller="Plan"
                       asp-action="Index"
                       class="btn btn-cancel">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Create Plan
                    </button>

                </div>

            </div>

        </form>

    </div>

</div>
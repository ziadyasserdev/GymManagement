@using GymManagement.BLL.Features.Plans.ViewModels
@model List<PlanViewModel>

@{
    ViewData["Title"] = "Plans";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show shadow-sm mt-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show shadow-sm mt-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">

        <div>
            <h1 class="fw-bold mb-2">Membership Plans</h1>

            <p class="text-muted mb-0">
                Manage your gym membership packages
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary px-4 py-2">
            <i class="bi bi-plus-lg me-2"></i>
            Add Plan
        </a>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var plan in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                        <!-- Card Header -->
                        <div class="p-4 @(plan.IsActive ? "bg-primary" : "bg-secondary") text-white">

                            <div class="d-flex justify-content-between align-items-start">

                                <div>
                                    <span class="badge bg-white text-dark mb-3">
                                        @(plan.IsActive ? "Active" : "Inactive")
                                    </span>

                                    <h3 class="fw-bold mb-1">
                                        @plan.Name
                                    </h3>

                                    <small class="opacity-75">
                                        Membership Plan
                                    </small>
                                </div>

                                <i class="bi bi-card-checklist fs-1 opacity-75"></i>

                            </div>

                        </div>


                        <!-- Card Body -->
                        <div class="card-body p-4 d-flex flex-column">

                            <!-- Price -->
                            <div class="text-center mb-4">

                                <div class="display-5 fw-bold text-dark">
                                    @plan.Price.ToString("N0")
                                    <span class="fs-6 text-muted">EGP</span>
                                </div>

                                <div class="text-muted mt-1">
                                    @plan.DurationDays days
                                </div>

                            </div>


                            <!-- Description -->
                            <div class="mb-4">

                                <h6 class="fw-bold mb-2">
                                    <i class="bi bi-info-circle me-2 text-primary"></i>
                                    Description
                                </h6>

                                <p class="text-muted mb-0">
                                    @plan.Description
                                </p>

                            </div>


                            <!-- Actions -->
                            <div class="mt-auto">

                                <a asp-action="Details"
                                   asp-route-id="@plan.Id"
                                   class="btn btn-outline-primary w-100 mb-2">

                                    <i class="bi bi-eye me-1"></i>
                                    View Details

                                </a>


                                <div class="d-flex gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@plan.Id"
                                       class="btn btn-outline-secondary flex-fill">

                                        <i class="bi bi-pencil me-1"></i>
                                        Edit

                                    </a>


                                    <form asp-action="Activate"
                                          asp-route-id="@plan.Id"
                                          method="post"
                                          class="flex-fill">

                                        <button type="submit"
                                                class="btn w-100 @(plan.IsActive
                                                                                                    ? "btn-outline-danger"
                                                                                                    : "btn-outline-success")">

                                    @if (plan.IsActive)
                                            {
                                                <i class="bi bi-x-circle me-1"></i>
                                                <span>Deactivate</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-check-circle me-1"></i>
                                                <span>Activate</span>
                                            }

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5">

            <div class="mb-3">
                <i class="bi bi-inbox display-1 text-muted"></i>
            </div>

            <h4 class="fw-bold">
                No Plans Available
            </h4>

            <p class="text-muted">
                There are currently no membership plans.
            </p>

            <a asp-action="Create"
               class="btn btn-primary mt-2">

                <i class="bi bi-plus-lg me-2"></i>
                Create First Plan

            </a>

        </div>
    }

</div>


@section Scripts {

    <partial name="_AlertBoxScript" />

}